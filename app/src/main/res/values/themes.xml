<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StreamHub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/sh_background</item>
        <item name="android:colorBackground">@color/sh_background</item>
        <item name="android:statusBarColor">@color/sh_background</item>
        <item name="android:navigationBarColor">@color/sh_background</item>
    </style>

    <style name="Theme.StreamHub.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sh_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.StreamHub</item>
    </style>
</resources>
